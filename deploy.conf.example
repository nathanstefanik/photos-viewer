# Copy to deploy.conf (gitignored) and fill in your homelab's real values.
# Sourced as a bash script by deploy.sh.

# Proxmox VE host or the LXC/VM's LAN IP (e.g. the CT running docker compose).
DEPLOY_HOST=192.168.1.20

# SSH user on that host/CT.
DEPLOY_USER=root

# Absolute path to the photos-viewer checkout on that host.
DEPLOY_PATH=/opt/photos-viewer

# SSH port, if not the default.
DEPLOY_PORT=22

# Optional: URL to poll after deploy to confirm the app came back up, e.g.
# http://192.168.1.20:8080/api/health. Leave blank to skip the check.
HEALTH_URL=
