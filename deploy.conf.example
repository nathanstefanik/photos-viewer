# Copy to deploy.conf (gitignored) to override deploy.sh defaults.
# Sourced as a bash script. Defaults already match this homelab.

# SSH host alias or LAN IP of the Proxmox VE node (not the CT).
PVE_HOST=pve

# LXC VMID running the viewer.
CTID=107

# Absolute path to the app tree inside that CT.
DEPLOY_PATH=/opt/photos-viewer
