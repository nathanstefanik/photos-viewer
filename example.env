# Copy to .env. Never commit real secrets.
# Fill real host values from LOCAL.md (gitignored) or your own setup.

IMMICH_URL=http://192.168.1.10:2283
# Immich UI → API Keys. Scopes: asset.read, asset.view, asset.download, person.read, server.about
IMMICH_API_KEY=

# Generate with: openssl rand -hex 32
SESSION_SECRET=

PUBLIC_BASE_URL=https://photos.example.com
CORS_ORIGINS=["https://photos.example.com"]
DEBUG=false
TOKENS_DB_PATH=/data/tokens.db

# Only needed if a reverse proxy (Caddy) sits in front of this app and you want
# rate limiting keyed by the real client IP instead of the proxy's IP. Leave
# both unset/false if you're not fronting this with a proxy that sets these
# headers — the app then rate-limits by the direct connection, which is safe
# either way, just less precise. Never set TRUST_X_FORWARDED_FOR=true without
# TRUSTED_PROXY_IPS: X-Forwarded-For is attacker-controlled from anyone who can
# reach this app directly, and trusting it unconditionally lets them bypass
# the /t/{code} rate limit by spoofing the header.
TRUST_X_FORWARDED_FOR=false
# IPs or CIDR ranges allowed to set X-Forwarded-For/X-Real-IP for us, e.g. the
# reverse proxy's address or your Docker bridge network:
# TRUSTED_PROXY_IPS=172.18.0.1
